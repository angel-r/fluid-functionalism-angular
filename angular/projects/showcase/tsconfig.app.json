/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [],
    /* Build against the packaged library, as users get it: linked FESMs that
       declare `sideEffects: false`, one per entry point. Run
       `ng build fluid-functionalism` first. The root alias points at the
       source, where a cross-entry import keeps the whole `index.ts` barrel. */
    "paths": {
      "@angel-r/fluid-functionalism-angular": ["../../dist/fluid-functionalism"],
      "@angel-r/fluid-functionalism-angular/*": ["../../dist/fluid-functionalism/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
