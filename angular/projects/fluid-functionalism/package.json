{
  "name": "@angel-r/fluid-functionalism-angular",
  "version": "0.0.1",
  "description": "Unofficial Angular port of Fluid Functionalism: components with fluid hover, merged selections and spring motion. Standalone, signal-based and zoneless.",
  "keywords": [
    "angular",
    "components",
    "ui",
    "tailwindcss",
    "signals",
    "fluid-functionalism"
  ],
  "license": "MIT",
  "author": "angel-r",
  "homepage": "https://github.com/angel-r/fluid-functionalism-angular/tree/main/angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angel-r/fluid-functionalism-angular.git",
    "directory": "angular/projects/fluid-functionalism"
  },
  "bugs": {
    "url": "https://github.com/angel-r/fluid-functionalism-angular/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/aria": "^22.2.0",
    "pdfjs-dist": "^5.7.0"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "motion": "^14.1.0",
    "class-variance-authority": "^0.7.1"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
